  "train_batch_size": 1,
  "gradient_accumulation_steps": 4,
  "num_workers": 0,
  "learning_rate": 0.0002,
  "adam_beta1": 0.9,
  "adam_beta2": 0.999,
  "adam_weight_decay": 0.0001,
  "adam_epsilon": 1e-08,
  "max_grad_norm": 1.0,
  "max_train_steps": 1200,
  "save_steps": 300,
  "log_every": 10,
  "rank": 16,
  "lora_alpha": 16,
  "lora_dropout": 0.05,
  "target_modules": ["to_q", "to_k"],
  "mixed_precision": "fp16",
  "allow_tf32": true,
  "gradient_checkpointing": true,
  "use_xformers_if_available": true,
  "num_validation_images": 1,
  "num_inference_steps": 24,
  "guidance_scale": 7.5,
  "negative_prompt": "low quality, blurry, distorted anatomy, watermark, text, oversaturated",
  "validation_prompts": [
    "traditional Chinese ink wash landscape, misty mountains, river, lone boat, elegant brushwork",
    "traditional ink wash painting of plum blossoms and magpies, blank space, subtle grayscale shading",
    "scholar playing guqin under a pine tree, Chinese ink painting, poetic atmosphere"
  ]
}
