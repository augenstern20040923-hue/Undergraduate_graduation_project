{
  "project_name": "paper_r16_s1200_6gb_full",
  "dataset_dir": "data/ink_painting_2192",
  "output_dir": "outputs/experiments_full/paper_r16_s1200_6gb_full",
  "pretrained_model_name_or_path": "runwayml/stable-diffusion-v1-5",
  "weight_name": "ink_painting_lora_r16_s1200_full.safetensors",
  "resolution": 512,
  "center_crop": true,
  "random_flip": false,
  "caption_dropout": 0.05,
